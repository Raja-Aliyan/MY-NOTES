# 27. Complete S3 Boto3 Practice

```python
import boto3
from moto import mock_aws

with mock_aws():

    # Create S3 client
    s3 = boto3.client(
        "s3",
        region_name="us-east-1"
    )

    # Create bucket
    s3.create_bucket(
        Bucket="my-first-boto3-bucket"
    )

    # List buckets
    response = s3.list_buckets()

    for bucket in response["Buckets"]:
        print("Bucket:", bucket["Name"])

    # Upload file
    s3.upload_file(
        "test.txt",
        "my-first-boto3-bucket",
        "test.txt"
    )

    # List objects
    response = s3.list_objects_v2(
        Bucket="my-first-boto3-bucket"
    )

    # Display object information
    for obj in response["Contents"]:
        print("Object:", obj["Key"])
        print("Size:", obj["Size"])
```

